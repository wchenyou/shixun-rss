VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Worker only. Never prefix privileged credentials with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OWNER_ID=
NODE_ID=home-mac-mini
WORKER_DATA_DIR=.data
CODEX_BIN=
# On macOS, auto-detect the CLI bundled with ChatGPT.app; set an explicit compatible CLI path elsewhere.
CODEX_LIMIT_IDS=codex
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
# web = live discovery; hybrid = discovery + RSS; rss = subscriptions only.
COLLECTION_MODE=web
WEB_SEARCH_INTERVAL_SECONDS=21600

# Quota-only fallback through local Claude Code subscription login.
CLAUDE_FALLBACK_ENABLED=1
CLAUDE_BIN=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_REASONING_EFFORT=medium
