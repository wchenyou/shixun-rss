VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Worker only. Never prefix privileged credentials with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OWNER_ID=
NODE_ID=home-mac-mini
WORKER_DATA_DIR=.data
CODEX_BIN=
# On macOS, auto-detect the CLI bundled with ChatGPT.app; set an explicit compatible CLI path elsewhere.
CODEX_LIMIT_IDS=codex
CODEX_MODEL=gpt-6.1-sol
# web = live discovery; hybrid = discovery + RSS; rss = subscriptions only.
COLLECTION_MODE=web
WEB_SEARCH_INTERVAL_SECONDS=21600
